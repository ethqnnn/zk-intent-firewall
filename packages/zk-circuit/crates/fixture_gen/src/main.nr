//! Prints the fixtures: `fixtures/Prover.toml` and `fixtures/vectors.json`.
//!
//! Every value is computed here with the same `policy_primitives` functions the circuit uses, from
//! the canonical scenario in `testkit`. Run it through `scripts/fixtures.sh`, which splits the
//! output on the BEGIN and END marker lines. Do not edit the fixture files by hand.
//!
//! This program is off-circuit tooling. It is not on the security path.

use policy_primitives::action::Action;
use policy_primitives::constants::{
    EMPTY_LEAF, MAX_LEAVES, POLICY_VERSION, SCOPE_BITS, TAG_ACTION_BINDING, TAG_ALLOWLIST_LEAF,
    TAG_ALLOWLIST_NODE, TAG_POLICY_COMMITMENT, TREE_DEPTH,
};
use policy_primitives::hash::{hash_leaf, poseidon2};
use policy_primitives::policy::Policy;
use testkit::scenario::{ALLOWLIST, canonical};
use testkit::tree::{dense_allowlist, zero_hashes};

global U64_MAX: u64 = 0xffffffffffffffff;
global U128_MAX: u128 = 0xffffffffffffffffffffffffffffffff;

/// A field element as `0x` followed by 64 lowercase hex digits, big-endian.
unconstrained fn hex(value: Field) -> str<66> {
    let digits: [u8; 16] = "0123456789abcdef".as_bytes();
    let bytes: [u8; 32] = value.to_be_bytes();
    let mut out: [u8; 66] = [0; 66];
    out[0] = 48; // '0'
    out[1] = 120; // 'x'
    for i in 0..32 {
        out[2 + 2 * i] = digits[(bytes[i] >> 4) as u32];
        out[3 + 2 * i] = digits[(bytes[i] & 15) as u32];
    }
    out.as_str_unchecked()
}

/// Prints the elements of a JSON or TOML array of hex strings, one per line.
unconstrained fn print_hex_items<let N: u32, let M: u32>(indent: str<M>, values: [Field; N]) {
    for i in 0..N {
        let item = hex(values[i]);
        if i + 1 == N {
            println(f"{indent}\"{item}\"");
        } else {
            println(f"{indent}\"{item}\",");
        }
    }
}

unconstrained fn print_poseidon2_vector<let N: u32>(inputs: [Field; N], last: bool) {
    let hash = hex(poseidon2(inputs));
    println("    {");
    println("      \"inputs\": [");
    print_hex_items("        ", inputs);
    println("      ],");
    println(f"      \"hash\": \"{hash}\"");
    if last {
        println("    }");
    } else {
        println("    },");
    }
}

unconstrained fn print_policy_case(policy: Policy, last: bool) {
    let max_amount = policy.max_amount;
    let allowlist_root = hex(policy.allowlist_root);
    let scope_mask = policy.scope_mask;
    let expiry = policy.expiry;
    let salt = hex(policy.salt);
    let commitment = hex(policy.commitment());
    println("      {");
    println("        \"policy\": {");
    println(f"          \"max_amount\": \"{max_amount}\",");
    println(f"          \"allowlist_root\": \"{allowlist_root}\",");
    println(f"          \"scope_mask\": \"{scope_mask}\",");
    println(f"          \"expiry\": \"{expiry}\",");
    println(f"          \"salt\": \"{salt}\"");
    println("        },");
    println(f"        \"policy_commitment\": \"{commitment}\"");
    if last {
        println("      }");
    } else {
        println("      },");
    }
}

unconstrained fn print_action_case(action: Action, last: bool) {
    let tool_id = hex(action.tool_id);
    let scope_index = action.scope_index;
    let amount = action.amount;
    let recipient = hex(action.recipient);
    let nonce = hex(action.nonce);
    let binding = hex(action.binding());
    println("      {");
    println("        \"action\": {");
    println(f"          \"tool_id\": \"{tool_id}\",");
    println(f"          \"scope_index\": \"{scope_index}\",");
    println(f"          \"amount\": \"{amount}\",");
    println(f"          \"recipient\": \"{recipient}\",");
    println(f"          \"nonce\": \"{nonce}\"");
    println("        },");
    println(f"        \"action_binding\": \"{binding}\"");
    if last {
        println("      }");
    } else {
        println("      },");
    }
}

unconstrained fn print_prover_toml() {
    let s = canonical();
    let policy_commitment = hex(s.policy_commitment);
    let current_timestamp = s.current_timestamp;
    let action_binding = hex(s.action_binding);
    let leaf_index = s.leaf_index;
    let max_amount = s.policy.max_amount;
    let allowlist_root = hex(s.policy.allowlist_root);
    let scope_mask = s.policy.scope_mask;
    let expiry = s.policy.expiry;
    let salt = hex(s.policy.salt);
    let tool_id = hex(s.action.tool_id);
    let scope_index = s.action.scope_index;
    let amount = s.action.amount;
    let recipient = hex(s.action.recipient);
    let nonce = hex(s.action.nonce);

    println("=== BEGIN Prover.toml ===");
    println(
        "# Valid inputs for the proof_of_intent circuit: the canonical fixture scenario.",
    );
    println(
        "# Generated by crates/fixture_gen through scripts/fixtures.sh. Do not edit by hand.",
    );
    println(
        "# Test data only. The salt and the nonce below are public and must never be reused.",
    );
    println("");
    println("# Public inputs, in order.");
    println(f"policy_commitment = \"{policy_commitment}\"");
    println(f"current_timestamp = \"{current_timestamp}\"");
    println(f"action_binding = \"{action_binding}\"");
    println("");
    println("# Private inputs: the Merkle witness for the recipient.");
    println(f"leaf_index = \"{leaf_index}\"");
    println("merkle_path = [");
    print_hex_items("    ", s.merkle_path);
    println("]");
    println("");
    println("# Private inputs: the policy opening.");
    println("[policy]");
    println(f"max_amount = \"{max_amount}\"");
    println(f"allowlist_root = \"{allowlist_root}\"");
    println(f"scope_mask = \"{scope_mask}\"");
    println(f"expiry = \"{expiry}\"");
    println(f"salt = \"{salt}\"");
    println("");
    println("# Private inputs: the action.");
    println("[action]");
    println(f"tool_id = \"{tool_id}\"");
    println(f"scope_index = \"{scope_index}\"");
    println(f"amount = \"{amount}\"");
    println(f"recipient = \"{recipient}\"");
    println(f"nonce = \"{nonce}\"");
    println("=== END Prover.toml ===");
}

unconstrained fn print_vectors_json() {
    let s = canonical();
    let zeros = zero_hashes();
    let p_minus_one: Field = 0 - 1;

    println("=== BEGIN vectors.json ===");
    println("{");
    println("  \"schema\": \"zkif.fixtures.v1\",");
    println(
        "  \"description\": \"Known-good inputs and outputs of the proof_of_intent circuit. Generated by the Noir code (crates/fixture_gen). Do not edit by hand. Field elements are 0x-prefixed 64-digit big-endian hex. Integers are decimal strings. See docs/circuit-spec.md.\",",
    );

    // --- constants ---------------------------------------------------------------------------
    let policy_version = hex(POLICY_VERSION);
    let empty_leaf = hex(EMPTY_LEAF);
    let max_field = hex(p_minus_one);
    let tag_commitment = hex(TAG_POLICY_COMMITMENT);
    let tag_leaf = hex(TAG_ALLOWLIST_LEAF);
    let tag_node = hex(TAG_ALLOWLIST_NODE);
    let tag_binding = hex(TAG_ACTION_BINDING);
    println("  \"constants\": {");
    println(
        "    \"field_modulus\": \"0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000001\",",
    );
    println(f"    \"largest_field_element\": \"{max_field}\",");
    println(f"    \"policy_version\": \"{policy_version}\",");
    println(f"    \"tree_depth\": \"{TREE_DEPTH}\",");
    println(f"    \"max_leaves\": \"{MAX_LEAVES}\",");
    println(f"    \"scope_bits\": \"{SCOPE_BITS}\",");
    println(f"    \"empty_leaf\": \"{empty_leaf}\",");
    println("    \"domain_tags\": {");
    println("      \"policy_commitment\": {");
    println("        \"label\": \"zkif.policy.commitment.v1\",");
    println(f"        \"value\": \"{tag_commitment}\"");
    println("      },");
    println("      \"allowlist_leaf\": {");
    println("        \"label\": \"zkif.allowlist.leaf.v1\",");
    println(f"        \"value\": \"{tag_leaf}\"");
    println("      },");
    println("      \"allowlist_node\": {");
    println("        \"label\": \"zkif.allowlist.node.v1\",");
    println(f"        \"value\": \"{tag_node}\"");
    println("      },");
    println("      \"action_binding\": {");
    println("        \"label\": \"zkif.action.binding.v1\",");
    println(f"        \"value\": \"{tag_binding}\"");
    println("      }");
    println("    }");
    println("  },");

    // --- the raw hash ------------------------------------------------------------------------
    println("  \"poseidon2\": [");
    print_poseidon2_vector([1], false);
    print_poseidon2_vector([1, 2], false);
    print_poseidon2_vector([1, 2, 3], false);
    print_poseidon2_vector([1, 2, 3, 4], false);
    print_poseidon2_vector([1, 2, 3, 4, 5], false);
    print_poseidon2_vector([1, 2, 3, 4, 5, 6], false);
    print_poseidon2_vector([1, 2, 3, 4, 5, 6, 7], false);
    print_poseidon2_vector([0, 0], false);
    print_poseidon2_vector([0, 0, 0], false);
    print_poseidon2_vector([p_minus_one, p_minus_one, p_minus_one], false);
    print_poseidon2_vector([1000], false);
    print_poseidon2_vector([1000, 2000], false);
    print_poseidon2_vector([1000, 2000, 3000], true);
    println("  ],");

    // --- the allowlist tree ------------------------------------------------------------------
    println("  \"zero_hashes\": [");
    print_hex_items("    ", zeros);
    println("  ],");

    let leaves = ALLOWLIST.map(|recipient| hash_leaf(recipient));
    let (root, _) = dense_allowlist(ALLOWLIST, 0);
    let root_hex = hex(root);
    println("  \"allowlist\": {");
    println("    \"recipients\": [");
    print_hex_items("      ", ALLOWLIST);
    println("    ],");
    println("    \"leaves\": [");
    print_hex_items("      ", leaves);
    println("    ],");
    println(f"    \"root\": \"{root_hex}\",");
    println("    \"proofs\": [");
    for position in 0..5 {
        let (proof_root, path) = dense_allowlist(ALLOWLIST, position);
        assert(proof_root == root);
        let recipient = hex(ALLOWLIST[position]);
        let leaf = hex(leaves[position]);
        println("      {");
        println(f"        \"leaf_index\": \"{position}\",");
        println(f"        \"recipient\": \"{recipient}\",");
        println(f"        \"leaf\": \"{leaf}\",");
        println("        \"merkle_path\": [");
        print_hex_items("          ", path);
        println("        ]");
        if position == 4 {
            println("      }");
        } else {
            println("      },");
        }
    }
    println("    ]");
    println("  },");

    // --- the canonical scenario --------------------------------------------------------------
    let max_amount = s.policy.max_amount;
    let allowlist_root = hex(s.policy.allowlist_root);
    let scope_mask = s.policy.scope_mask;
    let expiry = s.policy.expiry;
    let salt = hex(s.policy.salt);
    let policy_commitment = hex(s.policy_commitment);
    println("  \"policy\": {");
    println(f"    \"max_amount\": \"{max_amount}\",");
    println(f"    \"allowlist_root\": \"{allowlist_root}\",");
    println(f"    \"scope_mask\": \"{scope_mask}\",");
    println(f"    \"expiry\": \"{expiry}\",");
    println(f"    \"salt\": \"{salt}\"");
    println("  },");
    println(f"  \"policy_commitment\": \"{policy_commitment}\",");

    let tool_id = hex(s.action.tool_id);
    let scope_index = s.action.scope_index;
    let amount = s.action.amount;
    let recipient = hex(s.action.recipient);
    let nonce = hex(s.action.nonce);
    let action_binding = hex(s.action_binding);
    println("  \"action\": {");
    println(f"    \"tool_id\": \"{tool_id}\",");
    println(f"    \"scope_index\": \"{scope_index}\",");
    println(f"    \"amount\": \"{amount}\",");
    println(f"    \"recipient\": \"{recipient}\",");
    println(f"    \"nonce\": \"{nonce}\"");
    println("  },");
    println(f"  \"action_binding\": \"{action_binding}\",");

    let current_timestamp = s.current_timestamp;
    let timestamp_field = hex(s.current_timestamp as Field);
    let leaf_index = s.leaf_index;
    println(f"  \"current_timestamp\": \"{current_timestamp}\",");
    println("  \"merkle_witness\": {");
    println(f"    \"leaf_index\": \"{leaf_index}\",");
    println("    \"merkle_path\": [");
    print_hex_items("      ", s.merkle_path);
    println("    ]");
    println("  },");
    println("  \"public_inputs\": [");
    println(f"    \"{policy_commitment}\",");
    println(f"    \"{timestamp_field}\",");
    println(f"    \"{action_binding}\"");
    println("  ],");

    // --- edge cases: the top and bottom of every range ---------------------------------------
    println("  \"edge_cases\": {");
    println("    \"policy_commitments\": [");
    print_policy_case(
        Policy {
            max_amount: U128_MAX,
            allowlist_root: p_minus_one,
            scope_mask: U64_MAX,
            expiry: U64_MAX,
            salt: p_minus_one,
        },
        false,
    );
    print_policy_case(
        Policy { max_amount: 0, allowlist_root: 0, scope_mask: 0, expiry: 0, salt: 1 },
        false,
    );
    print_policy_case(
        Policy {
            max_amount: 18446744073709551616, // 2^64
            allowlist_root: zeros[TREE_DEPTH], // the empty allowlist
            scope_mask: 9223372036854775808, // 2^63
            expiry: 4294967296, // 2^32
            salt: 452312848583266388373324160190187140051835877600158453279131187530910662655, // 2^248 - 1
        },
        true,
    );
    println("    ],");
    println("    \"action_bindings\": [");
    print_action_case(
        Action {
            tool_id: p_minus_one,
            scope_index: 63,
            amount: U128_MAX,
            recipient: p_minus_one,
            nonce: p_minus_one,
        },
        false,
    );
    print_action_case(
        Action { tool_id: 0, scope_index: 0, amount: 1, recipient: 0, nonce: 0 },
        false,
    );
    print_action_case(
        Action {
            tool_id: 452312848583266388373324160190187140051835877600158453279131187530910662655, // 2^248 - 1
            scope_index: 32,
            amount: 18446744073709551616, // 2^64
            recipient: 1461501637330902918203684832716283019655932542975, // 2^160 - 1
            nonce: 340282366920938463463374607431768211455, // 2^128 - 1
        },
        true,
    );
    println("    ]");
    println("  }");
    println("}");
    println("=== END vectors.json ===");
}

unconstrained fn main() {
    print_prover_toml();
    print_vectors_json();
}
