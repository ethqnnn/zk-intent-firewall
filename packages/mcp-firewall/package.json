{
  "name": "@zk-intent-firewall/mcp-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "MCP middleware that blocks sensitive tool calls unless they carry a zero-knowledge proof of intent",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "circuit"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check:bbjs": "node scripts/bbjs-roundtrip.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noir-lang/noir_js": "1.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
