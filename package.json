{
  "name": "zk-intent-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-knowledge proof-of-intent firewall for AI agents that use the Model Context Protocol",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "test": "pnpm --recursive run --if-present test",
    "build": "pnpm --recursive run --if-present build",
    "circuit:test": "pnpm --filter @zk-intent-firewall/zk-circuit run test",
    "circuit:info": "pnpm --filter @zk-intent-firewall/zk-circuit run info",
    "circuit:execute": "pnpm --filter @zk-intent-firewall/zk-circuit run execute",
    "circuit:fmt:check": "pnpm --filter @zk-intent-firewall/zk-circuit run fmt:check",
    "circuit:verify": "pnpm --filter @zk-intent-firewall/zk-circuit run verify",
    "firewall:test": "pnpm --filter @zk-intent-firewall/mcp-firewall run test",
    "firewall:typecheck": "pnpm --filter @zk-intent-firewall/mcp-firewall run typecheck",
    "firewall:check:bbjs": "pnpm --filter @zk-intent-firewall/mcp-firewall run check:bbjs",
    "dashboard:dev": "pnpm --filter @zk-intent-firewall/demo-dashboard run dev",
    "dashboard:build": "pnpm --filter @zk-intent-firewall/demo-dashboard run build",
    "dashboard:start": "pnpm --filter @zk-intent-firewall/demo-dashboard run start",
    "dashboard:demo": "pnpm --filter @zk-intent-firewall/demo-dashboard run demo",
    "dashboard:test": "pnpm --filter @zk-intent-firewall/demo-dashboard run test",
    "dashboard:test:e2e": "pnpm --filter @zk-intent-firewall/demo-dashboard run test:e2e",
    "dashboard:mutation": "pnpm --filter @zk-intent-firewall/demo-dashboard run mutation",
    "dashboard:typecheck": "pnpm --filter @zk-intent-firewall/demo-dashboard run typecheck"
  }
}
