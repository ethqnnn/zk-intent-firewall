{
  "name": "@zk-intent-firewall/break-it",
  "version": "0.1.0",
  "private": true,
  "description": "Public break-it environment: the real circuit, firewall, passkey registry and verifier, against a fake-money ledger",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "deps:build": "pnpm --filter @zk-intent-firewall/mcp-firewall run build",
    "build": "pnpm run deps:build",
    "start": "node src/front/main.ts",
    "warm-crs": "node scripts/warm-crs.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm run deps:build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@zk-intent-firewall/demo-dashboard": "workspace:*",
    "@zk-intent-firewall/mcp-firewall": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
